# Copia este archivo a .env y rellena la key para desarrollo local.
# En producción, estas variables van en el panel del host (Netlify o
# Cloudflare), NUNCA en el repositorio.
#
# IMPORTANTE: sin prefijo VITE_. Cualquier variable VITE_* se hornea en el
# bundle del navegador y queda pública.

# Key de AeroDataBox (RapidAPI o acceso directo)
AERODATABOX_KEY=

# Host del proveedor. Por defecto el de RapidAPI; cámbialo si contratas
# el acceso directo o vía API.market.
AERODATABOX_HOST=aerodatabox.p.rapidapi.com
